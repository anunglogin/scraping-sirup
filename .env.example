# Copy to .env and fill in. NEVER commit .env.
#
# Passwords: use letters and digits only (A-Z, a-z, 0-9) because they are put
# inside a postgresql:// URL. Generate one with:
#   python -c "import secrets;print(secrets.token_hex(24))"

APP_VERSION=0.1.0

# --- Database (admin role: used by migrate, scraper, backup) ---
POSTGRES_DB=sirup
POSTGRES_USER=sirup_admin
POSTGRES_PASSWORD=change-me-alnum-only

# --- Read-only role used by the API (created on first DB start) ---
API_DB_USER=sirup_api
API_DB_PASSWORD=change-me-alnum-only

# --- API ---
# Comma-separated list, each key at least 24 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=change-me-at-least-24-characters-long
# Where the API listens on the host. 127.0.0.1 = this machine only.
API_BIND=127.0.0.1
API_PORT=8000

# --- Scraper ---
# Blank = current year (WIB). Fill only to re-fetch a specific year.
TAHUN_ANGGARAN=
SCRAPE_PAGE_SIZE=5000
SCRAPE_DELAY_SECONDS=2
# Daily start time, HH:MM in WIB.
SCRAPE_TIME=02:00
# Blank = no limit. Only for testing (e.g. 2 = fetch two pages and stop).
SCRAPE_MAX_PAGES=

# --- Backup ---
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=7

# --- PostgreSQL tuning (defaults sized for a 2 CPU / 4 GB VPS) ---
# Blank = default. Example for an 8 GB server: 2GB / 6GB.
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_WORK_MEM=
PG_MAINTENANCE_WORK_MEM=
PG_MAX_PARALLEL_WORKERS_PER_GATHER=
PG_MAX_PARALLEL_WORKERS=
