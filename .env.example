# Copy to .env and fill in. NEVER commit .env.
#
# Passwords: use letters and digits only (A-Z, a-z, 0-9) because they are put
# inside a postgresql:// URL. Generate one with:
#   python -c "import secrets;print(secrets.token_hex(24))"

APP_VERSION=0.1.0

# --- Database (admin role: used by migrate, scraper, backup) ---
POSTGRES_DB=sirup
POSTGRES_USER=sirup_admin
POSTGRES_PASSWORD=change-me-alnum-only

# --- Read-only role used by the API (created on first DB start) ---
API_DB_USER=sirup_api
API_DB_PASSWORD=change-me-alnum-only

# --- API ---
# Comma-separated list, each key at least 24 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=change-me-at-least-24-characters-long
# Where the API listens on the host. Keep 127.0.0.1 (this machine only).
# Do NOT use 0.0.0.0 on a VPS: the key would travel unencrypted. From outside
# use an SSH tunnel, or the https profile below (see docs/RUNBOOK.md).
API_BIND=127.0.0.1
API_PORT=8000
# Search limits (defaults are fine for a 4 GB VPS).
# A search slower than this is stopped (milliseconds).
DB_STATEMENT_TIMEOUT_MS=3000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# Max searches running at once; blank = DB_POOL_MAX_SIZE - 2. Extra ones get HTTP 429.
SEARCH_MAX_CONCURRENT=

# --- Scraper ---
# Blank = current year (WIB). Fill only to re-fetch a specific year.
TAHUN_ANGGARAN=
SCRAPE_PAGE_SIZE=5000
SCRAPE_DELAY_SECONDS=2
# Daily start time, HH:MM in WIB.
SCRAPE_TIME=02:00
# Blank = no limit. Only for testing (e.g. 2 = fetch two pages and stop).
SCRAPE_MAX_PAGES=

# --- Backup ---
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=7

# --- PostgreSQL tuning (defaults sized for a 2 CPU / 4 GB VPS) ---
# Blank = default. Example for an 8 GB server: 2GB / 6GB.
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_WORK_MEM=
PG_MAINTENANCE_WORK_MEM=
PG_MAX_PARALLEL_WORKERS_PER_GATHER=
PG_MAX_PARALLEL_WORKERS=

# --- Optional data.inaproc.id collector (docker compose --profile inaproc run --rm inaproc) ---
# Blank = current year.
INAPROC_TAHUN=
# Rows per page (1-100).
INAPROC_LIMIT=100
# Pages per run; 0 = until the end. A rerun continues from the saved cursor.
INAPROC_MAX_PAGES=10
# Pause between pages, at least 0.5 seconds.
INAPROC_DELAY_SECONDS=2
# Access pair from the written INAPROC/LKPP permission (TD-08). Real values go in .env only.
# Blank = header not sent (the site then answers 403).
INAPROC_X_SECRET=
INAPROC_REQUEST_TIME=

# --- Optional HTTPS (docker compose --profile https up -d) ---
# A (sub)domain whose DNS A record points to this server, e.g. sirup.example.co.id.
# Caddy obtains the certificate automatically (free, Let's Encrypt).
API_DOMAIN=
